# Copy this file to `.env` in the same directory (already gitignored) and
# fill in real values, or export these as real environment variables in
# whatever process runs sys5. Read by llm/client.py::build_chat_model().
#
# `.env` is loaded automatically (via python-dotenv) without overriding
# anything already set in the real environment, so this is safe to use
# alongside a deployment that sets these another way.

# Required. Bearer key for the OpenAI-compatible chat completions endpoint
# the pipeline calls. There is no working default - build_chat_model() raises
# LlmClientError immediately if this is unset.
OPENAI_API_KEY=sk-REPLACE_ME

# Optional. Base URL of the OpenAI-compatible gateway. If unset, falls back
# to DEFAULT_API_BASE in llm/client.py (currently the on-prem gateway
# http://10.1.2.186:4000) - set this to point at a different deployment.
SYS5_LLM_API_BASE=http://10.1.2.186:4000
